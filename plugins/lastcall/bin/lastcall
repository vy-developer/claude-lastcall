#!/usr/bin/env python3
"""Launcher for the `lastcall` command.

Resolves its own real path through any symlinks (so ~/.local/bin/lastcall ->
this file works), puts plugins/lastcall/lib on sys.path, and runs
lastcall_core.cli. Standard library only, Python 3.9+.
"""
import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write("lastcall needs Python 3.9 or newer (this is %s)\n"
                     % sys.version.split()[0])
    sys.exit(1)

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

from lastcall_core.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
